# Public landing page (Compose service `web`). Host port mapped to container 3000.
WEB_PORT=3000

# Gemini Live Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VOICE=Puck
# Live speech model; the models/ prefix is optional.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Voice engine. "openai" = Ayo: OpenAI Realtime hears + thinks (text only) and ElevenLabs speaks.
# Anything else (default "gemini") keeps the Gemini Live engine above.
VOICE_ENGINE=openai
# platform.openai.com > API keys. The account needs prepaid API credit (separate from ChatGPT plans).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# elevenlabs.io > Developers > API keys. Library voices such as Bukola need a paid plan (Starter is enough).
ELEVENLABS_API_KEY=
# Bukola (Nigerian, female) on the v4 Turbo model.
ELEVENLABS_VOICE_ID=oC2pCZZWEDRe6lmZpaaw
ELEVENLABS_MODEL=eleven_v4_turbo
# Optional override. Ayo's prompt ships in app/prompts/ayo_prompt.md and loads by default.
# AYO_PROMPT_PATH=app/prompts/ayo_prompt.md
# Ayo's recorded greeting (raw 8 kHz mu-law, Bukola, calm settings). Plays when the stream starts, so the agent
# speaks first. Unset = the bundled config/greeting_new_caller.ulaw; "off" = no recording (the engine speaks).
AYO_GREETING_AUDIO=config/greeting_new_caller.ulaw

# Telephony Ports
PORT=8000
AUDIOSOCKET_PORT=9020
ENABLE_AUDIOSOCKET=true

# Twilio: required for live phone calls and for the start_phone_call emergency tool.
# Find the Account SID, Auth Token and your number in the Twilio Console. A trial account
# can only call numbers verified in the Console, and plays a trial notice first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speaker verification (0.75 is an uncalibrated prototype threshold)
DATABASE_URL=
VOICE_VERIFICATION_THRESHOLD=0.75
# Also the model of the emergency subagent (it runs in the agent server, which receives GEMINI_API_KEY too).
HARNESS_MODEL=gemini-3.5-flash

# Photon 2.0 (beta) SMS: app.beta.photon.codes. Project ID (pho_prj_...) is in Settings, and the API key
# is under API keys (project:read + project:write, shown once). Buy an SMS number in the dashboard;
# its resource ID (pho_res_...) is all you need: the sender user is looked up and created on first send.
# To send to US numbers the line needs an approved 10DLC campaign, and a new line takes ~15 minutes to activate.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_RESOURCE_ID=
# Optional: the pho_usr_... User ID of the line's SMS agent. Leave empty to resolve it from PHOTON_RESOURCE_ID.
PHOTON_SENDER_ID=
# The responder both texts (Photon) and calls (Twilio), in E.164 format, e.g. +2348012345678.
EMERGENCY_RESPONDER_NUMBER=
# Optional: a second responder (E.164) the emergency agent texts when neither channel to the first one was accepted.
# Leave empty to skip that step of the escalation plan.
EMERGENCY_BACKUP_RESPONDER_NUMBER=

# Internal emergency worker and encrypted job storage.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMERGENCY_WORKER_SECRET=
# Generate a different random token for Agent Server access.
AGENT_SERVER_AUTH_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMERGENCY_JOB_ENCRYPTION_KEY=
# URLs between the app and the Agent Server (Compose overrides these with service names).
AGENT_SERVER_URL=http://127.0.0.1:2024
EMERGENCY_CALLBACK_URL=http://127.0.0.1:8000/internal/emergency-job
# Agent Server requires its own PostgreSQL database and a LangSmith API key/license.
AGENT_DATABASE_URI=
AGENT_REDIS_URI=redis://agent-redis:6379/0
LANGSMITH_API_KEY=
# LangSmith tracing (key from smith.langchain.com > Settings > API Keys). Traces include call content
# unless inputs/outputs are hidden: use synthetic demo calls only, never real callers.
# The application itself never traces (harness/tracing.py switches it off at startup, whatever this says), so this
# applies to the Agent Server, to LangGraph Studio and to scripts/trace_synthetic_call.py (a made-up call).
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ayo
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
LANGGRAPH_CLOUD_LICENSE_KEY=

# Live case dashboard at /dashboard (risk timeline, case plan, consent, emergency actions, responder acknowledgement;
# Live calls are never traced (a trace holds the child's words). Set true ONLY for your own test calls to send the
# case manager's runs (tagged live-test-call) to LANGSMITH_PROJECT.
TRACE_LIVE_CALLS=false
# no transcripts, names or phone numbers). Leave empty to turn it off. Needs at least 24 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# Enable only after safeguarding, identity and provider-data reviews.
COHERE_API_KEY=
SUPPORT_GUIDANCE_ENABLED=false
SUPPORT_MEMORY_ENABLED=false
# Generate a Fernet key and use a separate random identity HMAC key.
SUPPORT_MEMORY_ENCRYPTION_KEY=
SUPPORT_MEMORY_IDENTITY_KEY=
SUPPORT_MEMORY_RETENTION_DAYS=30
# Background case manager, a Deep Agents team (advisor every cycle; triage and researcher only when needed; RAG + skills + memory building). Needs GEMINI_API_KEY;
# retrieval additionally needs DATABASE_URL and COHERE_API_KEY. Defaults to HARNESS_MODEL.
COORDINATOR_MODEL=
# Comma-separated models tried if the coordinator model is overloaded or rate-limited.
COORDINATOR_FALLBACK_MODELS=gemini-3.5-flash-lite
# Minimum seconds between case-manager cycles (about 4 to 6 model calls on a typical cycle, about 10 when topics change). Use 0 on a paid API tier.
COORDINATOR_MIN_INTERVAL_SECONDS=8
# Where the speaker-recognition model is stored (mount a volume here in Docker).
SPEAKER_MODEL_DIR=
